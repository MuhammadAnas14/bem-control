// Copy this file to secrets.h (gitignored) and fill in real values.
//
// deviceKey, mqttUsername and apiKey come from provisioning a device in the
// web dashboard (Add device) or by scanning its QR code with the Bem Control
// mobile app - see backend/src/services/qrCode.service.js for the payload
// this data mirrors. The API key is shown exactly once at provisioning time.

#pragma once

// --- WiFi ---
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// --- Bem Control broker + identity ---
#define MQTT_HOST "192.168.1.50" // MQTT_DEVICE_HOST from backend/.env
#define MQTT_PORT 8883 // MQTTS (TLS)
#define ORG_ID "org_xxxxxxxxxxxxxxxxxxxxxx"
#define DEVICE_KEY "device_key_from_provisioning"
#define MQTT_USERNAME "device-device_key_from_provisioning"
#define MQTT_API_KEY "the_one_time_api_key_from_provisioning"

// --- Firmware metadata ---
#define FIRMWARE_VERSION "1.0.0"
