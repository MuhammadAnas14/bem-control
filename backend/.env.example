# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://bem:bem_dev_password@localhost:5432/bem_control?schema=public"

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# MQTT (Mosquitto). Run `npm run certs:generate` from the repo root first -
# it prints the generated MQTT_PASSWORD for the backend service account.
MQTT_URL=mqtts://localhost:8883
MQTT_USERNAME=bem-backend
MQTT_PASSWORD=replace-with-generated-password
MQTT_CA_CERT_PATH=./certs/ca.crt
# Where ESP32 devices (and the QR provisioning payload) should point - your
# LAN IP or public hostname, since devices aren't on "localhost".
MQTT_DEVICE_HOST=192.168.1.50
MQTT_DEVICE_PORT=8883

# WebSocket server (for pushing live telemetry to web/mobile clients)
WS_PORT=4001

# CORS
CORS_ORIGIN=http://localhost:5173
